USERNAME=
PASSWORD=

# Base32 TOTP secret. Generate one, then add it to your authenticator app
# as a "manual entry" key (SHA1, 6 digits, 30s step) — same value goes here:
#   php -r "require 'src/Totp.php'; echo OC_Totp::generateSecret(), PHP_EOL;"
TOTP=

# Bearer token for webhook.php (server-to-server calls, not device pairing).
#   openssl rand -hex 32
API_TOKEN=
